---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
---

<BaseLayout 
	title="Media" 
	description="Watch videos, view images, and download press materials for Nomad Poker - the innovative two-dimensional card game."
>
	<Hero 
		title="Media & Resources"
		subtitle="Videos, Images, and Press Materials"
	/>
	
	<!-- YouTube Videos -->
	<section class="py-16 bg-emerald-950">
		<div class="container mx-auto px-4">
			<h2 class="text-3xl md:text-4xl font-bold text-yellow-400 text-center mb-12">Videos</h2>
			<div class="max-w-4xl mx-auto">
				<Card>
					<div class="aspect-video mb-4 bg-emerald-800 rounded-lg flex items-center justify-center">
						<div class="text-center p-8">
							<svg class="w-16 h-16 mx-auto mb-4 text-red-600" fill="currentColor" viewBox="0 0 24 24">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
							</svg>
							<p class="text-amber-50 mb-4">Watch the latest updates and game development progress</p>
						</div>
					</div>
					<p class="text-amber-50 text-center mb-4">
						Visit our YouTube channel for the latest videos and updates on Nomad Poker development.
					</p>
					<div class="text-center">
						<a 
							href="https://www.youtube.com/channel/UCYQJCfrUhQUWxdUbposHeXg" 
							target="_blank" 
							rel="noopener noreferrer"
							class="inline-flex items-center space-x-2 bg-yellow-500 hover:bg-yellow-400 text-emerald-900 font-semibold px-6 py-2 rounded-lg transition-colors"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
							</svg>
							<span>Visit YouTube Channel</span>
						</a>
					</div>
				</Card>
			</div>
		</div>
	</section>
	
	<!-- Image Gallery -->
	<section class="py-16 bg-emerald-900">
		<div class="container mx-auto px-4">
			<h2 class="text-3xl md:text-4xl font-bold text-yellow-400 text-center mb-12">Image Gallery</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
				<Card class="p-0 overflow-hidden">
					<div class="aspect-square bg-emerald-800 flex items-center justify-center">
						<p class="text-amber-100/80 text-sm">Game Setup Image</p>
					</div>
					<div class="p-4">
						<p class="text-amber-50 text-sm">Game table setup showing the six hands</p>
					</div>
				</Card>
				<Card class="p-0 overflow-hidden">
					<div class="aspect-square bg-emerald-800 flex items-center justify-center">
						<p class="text-amber-100/80 text-sm">Gameplay Image</p>
					</div>
					<div class="p-4">
						<p class="text-amber-50 text-sm">Players engaged in a round of Nomad Poker</p>
					</div>
				</Card>
				<Card class="p-0 overflow-hidden">
					<div class="aspect-square bg-emerald-800 flex items-center justify-center">
						<p class="text-amber-100/80 text-sm">Cards Revealed</p>
					</div>
					<div class="p-4">
						<p class="text-amber-50 text-sm">Strategic moment as cards are revealed</p>
					</div>
				</Card>
				<Card class="p-0 overflow-hidden">
					<div class="aspect-square bg-emerald-800 flex items-center justify-center">
						<p class="text-amber-100/80 text-sm">Bar Setting</p>
					</div>
					<div class="p-4">
						<p class="text-amber-50 text-sm">Nomad Poker in a bar environment</p>
					</div>
				</Card>
				<Card class="p-0 overflow-hidden">
					<div class="aspect-square bg-emerald-800 flex items-center justify-center">
						<p class="text-amber-100/80 text-sm">Casino Setting</p>
					</div>
					<div class="p-4">
						<p class="text-amber-50 text-sm">Professional casino table setup</p>
					</div>
				</Card>
				<Card class="p-0 overflow-hidden">
					<div class="aspect-square bg-emerald-800 flex items-center justify-center">
						<p class="text-amber-100/80 text-sm">Logo & Branding</p>
					</div>
					<div class="p-4">
						<p class="text-amber-50 text-sm">Nomad Poker branding materials</p>
					</div>
				</Card>
			</div>
			<p class="text-center text-amber-100/80 mt-8 italic">
				Note: Actual game images will be added as they become available. Contact us for high-resolution images.
			</p>
		</div>
	</section>
	
	<!-- Press Kit -->
	<section class="py-16 bg-emerald-950">
		<div class="container mx-auto px-4">
			<h2 class="text-3xl md:text-4xl font-bold text-yellow-400 text-center mb-12">Press Kit</h2>
			<div class="max-w-3xl mx-auto">
				<Card>
					<h3 class="text-xl font-semibold text-yellow-400 mb-4">Download Press Materials</h3>
					<p class="text-amber-50 mb-6">
						Media professionals and potential partners can download high-resolution images, logos, and press releases. 
						For additional materials or interview requests, please contact us directly.
					</p>
					<div class="space-y-4">
						<div class="flex items-center justify-between p-4 bg-emerald-800 rounded-lg">
							<div>
								<h4 class="font-semibold text-amber-50">Press Release</h4>
								<p class="text-sm text-amber-100/80">Official press release and game information</p>
							</div>
							<a 
								href="/contact"
								class="bg-yellow-500 hover:bg-yellow-400 text-emerald-900 font-semibold px-4 py-2 rounded transition-colors"
							>
								Request
							</a>
						</div>
						<div class="flex items-center justify-between p-4 bg-emerald-800 rounded-lg">
							<div>
								<h4 class="font-semibold text-amber-50">High-Resolution Images</h4>
								<p class="text-sm text-amber-100/80">Game photos, logos, and promotional images</p>
							</div>
							<a 
								href="/contact"
								class="bg-yellow-500 hover:bg-yellow-400 text-emerald-900 font-semibold px-4 py-2 rounded transition-colors"
							>
								Request
							</a>
						</div>
						<div class="flex items-center justify-between p-4 bg-emerald-800 rounded-lg">
							<div>
								<h4 class="font-semibold text-amber-50">Brand Guidelines</h4>
								<p class="text-sm text-amber-100/80">Logo usage, colors, and branding standards</p>
							</div>
							<a 
								href="/contact"
								class="bg-yellow-500 hover:bg-yellow-400 text-emerald-900 font-semibold px-4 py-2 rounded transition-colors"
							>
								Request
							</a>
						</div>
					</div>
				</Card>
			</div>
		</div>
	</section>
	
	<!-- Social Media -->
	<section class="py-16 bg-emerald-900">
		<div class="container mx-auto px-4">
			<h2 class="text-3xl md:text-4xl font-bold text-yellow-400 text-center mb-12">Follow Our Journey</h2>
			<div class="max-w-2xl mx-auto text-center">
				<p class="text-lg text-amber-50 mb-8">
					Stay updated with the latest news, game development updates, and community highlights.
				</p>
				<div class="flex justify-center space-x-6">
					<a 
						href="https://www.youtube.com/channel/UCYQJCfrUhQUWxdUbposHeXg" 
						target="_blank" 
						rel="noopener noreferrer"
						class="flex items-center space-x-2 bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
							<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
						</svg>
						<span>YouTube</span>
					</a>
					<a 
						href="https://www.facebook.com/profile.php?id=61578170496335&sk=about" 
						target="_blank" 
						rel="noopener noreferrer"
						class="flex items-center space-x-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
							<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
						</svg>
						<span>Facebook</span>
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
