---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
---

<BaseLayout 
	title="Contact" 
	description="Get in touch with Nomad Poker for licensing opportunities, partnership inquiries, or general questions. Contact Randy Glover at randy@NomadPoker.com"
>
	<Hero 
		title="Get in Touch"
		subtitle="Let's Bring Nomad Poker to Your Venue"
	/>
	
	<!-- Contact Information -->
	<section class="py-16 bg-emerald-950">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
					<Card>
						<h3 class="text-2xl font-semibold text-yellow-400 mb-4">Email</h3>
						<p class="text-amber-50 mb-4">
							For all inquiries, partnerships, and licensing opportunities:
						</p>
						<a 
							href="mailto:randy@NomadPoker.com"
							class="text-yellow-400 hover:text-yellow-300 text-lg font-semibold transition-colors"
						>
							randy@NomadPoker.com
						</a>
					</Card>
					<Card>
						<h3 class="text-2xl font-semibold text-yellow-400 mb-4">Location</h3>
						<p class="text-amber-50 mb-2">
							<strong>Nomad Poker</strong><br />
							d.b.a. RLG Technologies
						</p>
						<p class="text-amber-50">
							Roseville, CA 95747<br />
							United States
						</p>
					</Card>
				</div>
			</div>
		</div>
	</section>
	
	<!-- Business Inquiries -->
	<section class="py-16 bg-emerald-900">
		<div class="container mx-auto px-4">
			<div class="max-w-3xl mx-auto">
				<Card>
					<h2 class="text-3xl font-bold text-yellow-400 mb-6 text-center">Business Inquiries</h2>
					<div class="space-y-6">
						<div>
							<h3 class="text-xl font-semibold text-yellow-400 mb-3">For Bars & Restaurants</h3>
							<p class="text-amber-50">
								Interested in adding Nomad Poker to your establishment? We offer licensing options and support 
								to help you integrate the game into your venue. Contact us to learn about partnership opportunities, 
								equipment requirements, and how Nomad Poker can enhance your customer experience and increase revenue.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold text-yellow-400 mb-3">For Casinos</h3>
							<p class="text-amber-50">
								Nomad Poker is designed with casino environments in mind. We're looking for casino partners who want 
								to offer a unique, innovative card game experience. Contact us to discuss licensing, training, and 
								implementation options for your casino floor.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold text-yellow-400 mb-3">For Distributors & Partners</h3>
							<p class="text-amber-50">
								We're open to partnerships with game distributors, manufacturers, and other industry partners who can 
								help bring Nomad Poker to a wider audience. If you're interested in distribution or partnership 
								opportunities, we'd love to hear from you.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold text-yellow-400 mb-3">For Media & Press</h3>
							<p class="text-amber-50">
								Media professionals interested in covering Nomad Poker can contact us for press materials, interviews, 
								and additional information. Visit our <a href="/media" class="text-yellow-400 hover:text-yellow-300 underline">Media page</a> for available resources.
							</p>
						</div>
					</div>
				</Card>
			</div>
		</div>
	</section>
	
	<!-- Contact Form Section -->
	<section class="py-16 bg-emerald-950">
		<div class="container mx-auto px-4">
			<div class="max-w-2xl mx-auto">
				<Card>
					<h2 class="text-3xl font-bold text-yellow-400 mb-6 text-center">Send Us a Message</h2>
					<form 
						action="mailto:randy@NomadPoker.com"
						method="post"
						enctype="text/plain"
						class="space-y-6"
					>
						<div>
							<label for="name" class="block text-amber-50 font-medium mb-2">
								Name <span class="text-yellow-400">*</span>
							</label>
							<input 
								type="text" 
								id="name" 
								name="name" 
								required
								class="w-full px-4 py-2 bg-emerald-800 border border-yellow-500/30 rounded-lg text-amber-50 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
							/>
						</div>
						<div>
							<label for="email" class="block text-amber-50 font-medium mb-2">
								Email <span class="text-yellow-400">*</span>
							</label>
							<input 
								type="email" 
								id="email" 
								name="email" 
								required
								class="w-full px-4 py-2 bg-emerald-800 border border-yellow-500/30 rounded-lg text-amber-50 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
							/>
						</div>
						<div>
							<label for="subject" class="block text-amber-50 font-medium mb-2">
								Subject <span class="text-yellow-400">*</span>
							</label>
							<select 
								id="subject" 
								name="subject" 
								required
								class="w-full px-4 py-2 bg-emerald-800 border border-yellow-500/30 rounded-lg text-amber-50 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
							>
								<option value="">Select a topic...</option>
								<option value="Bar/Restaurant Partnership">Bar/Restaurant Partnership</option>
								<option value="Casino Partnership">Casino Partnership</option>
								<option value="Distribution/Wholesale">Distribution/Wholesale</option>
								<option value="Media/Press Inquiry">Media/Press Inquiry</option>
								<option value="General Question">General Question</option>
							</select>
						</div>
						<div>
							<label for="message" class="block text-amber-50 font-medium mb-2">
								Message <span class="text-yellow-400">*</span>
							</label>
							<textarea 
								id="message" 
								name="message" 
								rows="6" 
								required
								class="w-full px-4 py-2 bg-emerald-800 border border-yellow-500/30 rounded-lg text-amber-50 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent resize-vertical"
							></textarea>
						</div>
						<div class="text-center">
							<button 
								type="submit"
								class="bg-yellow-500 hover:bg-yellow-400 text-emerald-900 font-semibold px-8 py-3 rounded-lg transition-colors"
							>
								Send Message
							</button>
						</div>
						<p class="text-sm text-amber-100/80 text-center">
							Alternatively, you can email us directly at <a href="mailto:randy@NomadPoker.com" class="text-yellow-400 hover:text-yellow-300 underline">randy@NomadPoker.com</a>
						</p>
					</form>
				</Card>
			</div>
		</div>
	</section>
	
	<!-- Social Links -->
	<section class="py-16 bg-emerald-900">
		<div class="container mx-auto px-4">
			<div class="max-w-2xl mx-auto text-center">
				<h2 class="text-3xl font-bold text-yellow-400 mb-6">Connect With Us</h2>
				<p class="text-amber-50 mb-8">
					Follow our journey and stay updated with the latest news and developments.
				</p>
				<div class="flex justify-center space-x-6">
					<a 
						href="https://www.youtube.com/channel/UCYQJCfrUhQUWxdUbposHeXg" 
						target="_blank" 
						rel="noopener noreferrer"
						class="flex items-center space-x-2 bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
							<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
						</svg>
						<span>YouTube</span>
					</a>
					<a 
						href="https://www.facebook.com/profile.php?id=61578170496335&sk=about" 
						target="_blank" 
						rel="noopener noreferrer"
						class="flex items-center space-x-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
							<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
						</svg>
						<span>Facebook</span>
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
