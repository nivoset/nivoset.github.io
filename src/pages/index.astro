---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const recentAIPosts = sortedPosts
  .filter(({ data }) => data.tags.some(tag => tag.toLowerCase() === "ai"))
  .slice(0, 3);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero" class="hero-section">
      <div class="hero-content">
        <h1 class="hero-title">Marginal Notes</h1>
        <div class="hero-subtitle-wrapper">
          <a
            target="_blank"
            href="/rss.xml"
            class="rss-link"
            aria-label="rss feed"
            title="RSS Feed"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon">
              <path
                d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
              ></path>
              <path
                d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
              ></path>
              <circle cx="6" cy="18" r="2"></circle>
            </svg>
          </a>
        </div>

        <div class="hero-description">
          <p>
            Notes on the tools, automation, and code I build — the name comes from
            drawing comics in the margins of my homework as a kid, and it stuck as
            the catchall for whatever I'm working on.
          </p>
        </div>
        
        {
          // only display if at least one social link is enabled
          socialCount > 0 && (
            <div class="social-wrapper">
              <div class="social-links">Connect:</div>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    {
      recentAIPosts.length > 0 && (
        <section id="ai-posts" class="content-section">
          <h2 class="section-header">Recent AI Posts</h2>
          <p class="section-subheader">The latest articles about AI</p>
          <ul class="card-grid">
            {recentAIPosts.map(({ data }) => (
              <Card
                href={`/posts/${slugify(data)}`}
                frontmatter={data}
                secHeading={false}
              />
            ))}
          </ul>
        </section>
      )
    }

    <section id="recent-posts" class="content-section">
      <div class="section-header-wrapper">
        <h2 class="section-header">Recent Posts</h2>
        <LinkButton href="/posts" class="view-all-link">
          View All
          <svg xmlns="http://www.w3.org/2000/svg" class="arrow-icon">
            <path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
      </div>
      <ul class="card-grid">
        {
          sortedPosts.map(
            ({ data }, index) =>
              index < 6 && (
                <Card
                  href={`/posts/${slugify(data)}`}
                  frontmatter={data}
                  secHeading={false}
                />
              )
          )
        }
      </ul>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @reference "tailwindcss";
  /* ===== Hero Section ===== */
  .hero-section {
    @apply pt-8 pb-10 sm:pt-10 sm:pb-12;
  }
  
  .hero-content {
    @apply max-w-3xl;
  }
  
  .hero-title {
    @apply text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100 
    mb-6 sm:text-5xl md:text-6xl bg-gradient-to-r from-blue-600 to-blue-500 
    dark:from-orange-500 dark:to-orange-400 bg-clip-text text-transparent;
  }
  
  .hero-subtitle-wrapper {
    @apply mb-6;
  }
  
  .rss-link {
    @apply inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 
    hover:text-blue-600 dark:hover:text-orange-500 transition-colors;
  }
  
  .rss-icon {
    @apply h-5 w-5 fill-current;
  }
  
  .hero-description {
    @apply space-y-4 mb-8;
  }
  
  .hero-description p {
    @apply text-lg text-gray-700 dark:text-gray-300 leading-relaxed;
  }
  
  .social-wrapper {
    @apply flex flex-col gap-3 sm:flex-row sm:items-center pt-4 border-t border-gray-200 dark:border-slate-800;
  }
  
  .social-links {
    @apply text-sm font-medium text-gray-600 dark:text-gray-400 whitespace-nowrap;
  }

  /* ===== Content Sections ===== */
  .content-section {
    @apply pt-16 pb-12 sm:pt-20;
  }
  
  .section-header-wrapper {
    @apply flex items-center justify-between mb-6;
  }
  
  .section-header {
    @apply text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 mb-2;
  }
  
  .section-subheader {
    @apply text-lg text-gray-600 dark:text-gray-400 mb-8;
  }
  
  .view-all-link {
    @apply text-sm font-medium text-blue-600 dark:text-orange-500 
    hover:underline flex items-center gap-1;
  }
  
  .arrow-icon {
    @apply h-4 w-4 fill-current;
  }
  
  .card-grid {
    @apply grid gap-6 md:grid-cols-2 lg:grid-cols-3;
  }
  
  .card-grid li {
    @apply m-0;
  }
</style>
