---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout title="B. Koop — Product-minded engineer & designer" description="Selected product, engineering, and creative work by B. Koop: thoughtful interfaces, reliable systems, and playful experiments.">
  <Header />
  <main id="main-content" class="portfolio">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> B. Koop <span class="eyebrow-divider">/</span> Product-minded engineer</p>
        <h1 id="intro-title">I make complex things<br /><span>feel clear.</span></h1>
        <p class="lede">Staff-level engineer with a designer’s eye for detail. I work across interaction design, design systems, and the engineering behind dependable products.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#selected-work">Explore selected work <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="mailto:nivoset@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-meta"><span>React · TypeScript · Product UI</span><span>Based in the details</span></div>
      </div>
      <div class="hero-art" aria-label="Abstract illustration of a path connecting ideas">
        <div class="art-note note-one">make it useful</div><div class="art-note note-two">make it feel right</div>
        <svg viewBox="0 0 520 420" role="img" aria-labelledby="art-title art-desc">
          <title id="art-title">A winding path through a field of ideas</title><desc id="art-desc">A deep green line connects small lavender and coral markers across a pale background.</desc>
          <path class="path-shadow" d="M74 329 C95 255 123 267 153 292 S199 336 225 278 C251 219 229 167 281 157 S343 191 365 141 C391 84 435 114 455 72" />
          <path class="path-line" d="M74 329 C95 255 123 267 153 292 S199 336 225 278 C251 219 229 167 281 157 S343 191 365 141 C391 84 435 114 455 72" />
          <circle cx="74" cy="329" r="10" class="mark-coral"/><circle cx="225" cy="278" r="8" class="mark-lavender"/><circle cx="281" cy="157" r="7" class="mark-green"/><circle cx="365" cy="141" r="11" class="mark-coral"/><circle cx="455" cy="72" r="9" class="mark-lavender"/>
          <circle cx="74" cy="329" r="24" class="halo"/><circle cx="365" cy="141" r="28" class="halo"/>
        </svg>
        <span class="art-caption">curiosity → clarity → craft</span>
      </div>
    </section>

    <section class="work-intro" id="selected-work" aria-labelledby="work-title">
      <div><p class="eyebrow">Selected work</p><h2 id="work-title">Two ways into the work.</h2></div>
      <p class="section-intro">Product design and creative experiments share a home here with the engineering that makes products dependable. Pick the kind of problem you want to explore.</p>
    </section>
    <nav class="path-selectors" aria-label="Explore work by focus">
      <a href="#design-work"><span class="path-index">A</span><span><strong>Design &amp; interaction</strong><small>Systems, interfaces, and playful prototypes</small></span><span class="path-arrow" aria-hidden="true">↘</span></a>
      <a href="#engineering-work"><span class="path-index">B</span><span><strong>Engineering &amp; quality</strong><small>Reliable workflows and tools for teams</small></span><span class="path-arrow" aria-hidden="true">↘</span></a>
    </nav>

    <section class="work-group" id="design-work" aria-labelledby="design-title">
      <div class="group-heading"><p class="eyebrow">Design &amp; interaction</p><h3 id="design-title">Make the system make sense.</h3></div>
      <div class="work-grid">
        <article class="work-card">
          <div class="card-topline"><span class="work-number">01</span><span class="work-type">Product design · Systems</span></div>
          <div class="card-visual systems-visual" aria-hidden="true"><div class="system-label">DESIGN SYSTEMS</div><div class="system-row"><span class="swatch s1"></span><span>Tokens</span><span class="row-line"></span><b>01</b></div><div class="system-row"><span class="swatch s2"></span><span>Components</span><span class="row-line"></span><b>02</b></div><div class="system-row"><span class="swatch s3"></span><span>Patterns</span><span class="row-line"></span><b>03</b></div><div class="system-foot">CONSISTENCY THAT SCALES <span>↗</span></div></div>
          <div class="card-copy"><p class="eyebrow">Routable · design system modernization</p><h4>Shared foundations for product UI</h4><p>Contributed to modernizing Routable’s design system in a React product environment. The work sat at the intersection of reusable UI foundations and the needs of teams building real product experiences.</p><ul class="chips"><li>Design systems</li><li>React</li><li>UI architecture</li></ul></div>
        </article>
        <article class="work-card">
          <div class="card-topline"><span class="work-number">02</span><span class="work-type">Exploration · Information design</span></div>
          <div class="card-visual conversation-visual" aria-hidden="true"><aside class="conversation-sidebar"><div class="conversation-sidebar-head"><strong>LINES</strong><span>32 segments</span></div><div class="conversation-line-list"><div><i class="line-check">✓</i><i class="line-dot dot-blue"></i><span>what env varia...</span><small>20</small><b>•••</b></div><div><i class="line-check">✓</i><i class="line-dot dot-gold"></i><span>is the dist folde...</span><small>4</small><b>•••</b></div><div><i class="line-check">✓</i><i class="line-dot dot-green"></i><span>Vette beta com...</span><small>2</small><b>•••</b></div><div><i class="line-check">✓</i><i class="line-dot dot-yellow"></i><span>what is the url f...</span><small>5</small><b>•••</b></div></div><div class="conversation-note"><i></i><span>Exchange flight path; changing included event types redraws its geometry from the remaining events.</span></div><div class="conversation-legend"><span>◆ System</span><span>● Human</span><span>◆ AI</span><span>■ Tool</span></div><div class="conversation-filters"><strong>Include nodes</strong><span>☑ System　☑ Human</span><span>☑ AI　☑ Tool calls</span><span>☑ Tool results</span></div></aside><div class="conversation-canvas"><svg viewBox="0 0 600 260" preserveAspectRatio="none"><g class="conversation-grid"><path d="M0 115H600M0 155H600M0 200H600M0 250H600"/><path d="M85 95L0 260M200 95L120 260M315 95L290 260M430 95L470 260M545 95L600 260"/></g><path class="conversation-path path-gold" d="M90 92C135 81 150 54 205 52S278 57 315 42"/><path class="conversation-path path-amber" d="M90 94C142 110 183 84 238 82S281 73 307 65"/><path class="conversation-path path-cyan" d="M90 96C145 115 180 113 221 126S289 130 330 146 380 157 419 142 451 123 464 142 447 192 431 215 463 180 479 157 504 133 550 122 574 117 595 115"/></svg><span class="conversation-hint">Drag to orbit · scroll to zoom · click to select</span></div></div>
          <div class="card-copy"><p class="eyebrow">Personal prototype · visual exploration</p><h4>Finding a path through a conversation</h4><p>An early 3D exploration of colored conversation paths with filters for messages and tool activity. The visual metaphor bends and kinks to invite a person to notice where their attention shifts. It is an exploratory interface, not a validated measure of focus.</p><ul class="chips"><li>Information design</li><li>3D exploration</li><li>Interaction</li></ul></div>
        </article>
        <article class="work-card">
          <div class="card-topline"><span class="work-number">03</span><span class="work-type">Creative coding · Play</span></div>
          <div class="card-visual game-visual" aria-hidden="true"><div class="game-grid"><span></span><span></span><span></span><span></span><span class="tile coral"></span><span></span><span class="tile lavender"></span><span></span><span></span><span></span><span class="tile green"></span><span></span><span></span><span class="tile coral"></span><span></span><span></span></div><div class="game-caption">SLIDE / THINK / REPEAT</div></div>
          <div class="card-copy"><p class="eyebrow">Play Lab · browser prototypes</p><h4>Small games, playful rules</h4><p>Slide-Tris and Spin Maze are compact playable experiments. Each explores how a small change to a rule or movement can turn a familiar interaction into a fresh puzzle.</p><ul class="chips"><li>Prototyping</li><li>Interaction</li><li>Games</li></ul><a class="card-link" href="/play">Visit Play Lab <span aria-hidden="true">↗</span></a></div>
        </article>
      </div>
    </section>

    <section class="work-group" id="engineering-work" aria-labelledby="engineering-title">
      <div class="group-heading"><p class="eyebrow">Engineering &amp; quality</p><h3 id="engineering-title">Make the work dependable.</h3></div>
      <div class="work-grid">
        <article class="work-card">
          <div class="card-topline"><span class="work-number">04</span><span class="work-type">Personal tool · Quality</span></div>
          <div class="card-visual vette-visual" aria-hidden="true"><div class="quality-flow"><div class="quality-step"><span>01</span><b>Reproduce the issue</b></div><div class="quality-connector">→</div><div class="quality-step"><span>02</span><b>Verify the test</b></div><div class="quality-connector">→</div><div class="quality-step"><span>03</span><b>Blind second pass</b></div></div><div class="quality-foot">TEST-DRIVEN REVIEW LOOP</div></div>
          <div class="card-copy"><p class="eyebrow">Personal tool · AI-assisted reviews</p><h4>Vette</h4><p>Automated reviews grounded in reproduced behavior. Vette checks that a regression test catches the reported issue, then uses a blind secondary reviewer to look for missed cases. The review workflow includes TDD and mutation checks.</p><ul class="chips"><li>React</li><li>TypeScript</li><li>Testing</li><li>AI-assisted</li></ul></div>
        </article>
        <article class="work-card">
          <div class="card-topline"><span class="work-number">05</span><span class="work-type">Developer experience · CI</span></div>
          <div class="card-visual pipeline-visual" aria-hidden="true"><div class="pipeline-label">CI / PR FEEDBACK</div><div class="pipeline-line"><span class="pipe-node done">✓</span><span class="pipe-track"></span><span class="pipe-node done">✓</span><span class="pipe-track"></span><span class="pipe-node active">↗</span></div><div class="pipeline-stages"><span>Commit</span><span>Checks</span><span>Review</span></div><div class="pipeline-metric"><strong>60 → 20</strong><small>minutes reported pipeline time</small></div></div>
          <div class="card-copy"><p class="eyebrow">G2i · multi-repository work</p><h4>Shorter feedback loops</h4><p>Helped improve CI and pull-request workflows across multiple repositories. Reported pipeline time moved from about 60 minutes to about 20 minutes, giving teams faster feedback while they worked.</p><ul class="chips"><li>CI / CD</li><li>Developer experience</li><li>Team workflows</li></ul></div>
        </article>
      </div>
    </section>

    <section class="proof-band" aria-label="Additional experience"><div><span class="proof-kicker">A little more context</span><strong>Design-minded engineering,<br />grounded in real workflows.</strong></div><p>At Smartrise, I wrote a test plan and automated parts of the testing workflow. Monthly controller output grew from 60 to 300+ as the team expanded from 3 to 4 test techs, alongside additional wiring staff. At Chase, I helped nontechnical and technical colleagues learn to write runnable basic tests in a 30-minute session.</p><a href="/about" class="text-link">More about me <span aria-hidden="true">↗</span></a></section>

    <section class="writing" aria-labelledby="writing-title"><div class="section-heading"><div><p class="eyebrow">Field notes</p><h2 id="writing-title">Thinking out loud.</h2></div><a class="text-link" href="/posts">All writing <span aria-hidden="true">↗</span></a></div><ul class="writing-grid">{sortedPosts.slice(0, 3).map(({ data }) => <Card href={`/posts/${slugify(data)}`} frontmatter={data} secHeading={false} />)}</ul></section>
    <section class="contact"><p class="eyebrow">Have a good problem?</p><h2>Let’s make it clearer.</h2><a class="button button-primary" href="mailto:nivoset@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a>{socialCount > 0 && <div class="social-links"><Socials /></div>}</section>
  </main>
  <Footer />
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  .portfolio { --ink: var(--site-foreground); --muted: var(--site-muted); --green: var(--site-accent); --green-dark: var(--site-accent-hover); --lavender: #d8cff1; --paper: var(--site-canvas); --coral: #e98770; }
  .portfolio section { max-width: 1120px; }
  .hero { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 2rem; min-height: 540px; padding-top: 3rem; padding-bottom: 4rem; }
  .hero-copy { max-width: 640px; }
  .eyebrow { margin: 0 0 .8rem; color: var(--green); font: 700 .72rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; }
  .status-dot { display: inline-block; width: .5rem; height: .5rem; margin-right: .45rem; border-radius: 50%; background: #7c9d72; box-shadow: 0 0 0 4px #7c9d7224; }
  .eyebrow-divider { padding: 0 .45rem; color: #b5aea1; }
  .hero h1 { margin: 0; color: var(--ink); font-size: clamp(3.4rem, 7vw, 6.1rem); line-height: .96; letter-spacing: -.02em; font-weight: 760; }
  .hero h1 span { color: var(--green); }
  .lede { max-width: 560px; margin: 1.6rem 0 0; color: var(--site-muted); font-size: 1.16rem; line-height: 1.75; }
  .hero-actions { display: flex; align-items: center; gap: 1.4rem; margin-top: 1.8rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: .8rem; border-radius: 999px; padding: .82rem 1.15rem; font-size: .92rem; font-weight: 700; text-decoration: none; }
  .button-primary { color: var(--site-accent-foreground); background: var(--green); box-shadow: 0 8px 22px #255b4728; }
  .button-primary:hover { color: var(--site-accent-foreground); background: var(--green-dark); transform: translateY(-2px); }
  .text-link { display: inline-flex; gap: .45rem; align-items: center; color: var(--green); font-size: .9rem; font-weight: 700; text-decoration: none; }
  .text-link:hover,.card-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .hero-meta { display: flex; gap: 1.3rem; margin-top: 2.7rem; color: var(--site-muted); font: 600 .7rem ui-monospace, monospace; letter-spacing: .04em; text-transform: uppercase; }
  .hero-art { position: relative; min-height: 410px; overflow: hidden; border: 0; border-radius: 48% 46% 40% 42% / 43% 42% 48% 49%; }
  .hero-art::before { content: ""; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(ellipse at center, #dce6dc 0%, #d5e0d3 100%); -webkit-mask-image: radial-gradient(ellipse at center, #000 76%, transparent 100%); mask-image: radial-gradient(ellipse at center, #000 76%, transparent 100%); }
  .hero-art svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .path-shadow,.path-line { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .path-shadow { stroke: #d4cbed; stroke-width: 14; opacity: .45; transform: translate(2px, 5px); }
  .path-line { stroke: var(--green); stroke-width: 4; stroke-dasharray: 3 0; }
  .mark-coral { fill: var(--coral); }.mark-lavender { fill: #a495d0; }.mark-green { fill: var(--green); }.halo { fill: none; stroke: #b7aaDC; stroke-width: 1.5; opacity: .55; }
  .art-note { position: absolute; z-index: 1; border: 1px solid #e2ded5; border-radius: 99px; padding: .48rem .75rem; color: #59685e; background: #fbfaf6e8; font: 600 .72rem ui-monospace, monospace; box-shadow: 0 5px 14px #33483c10; }
  .note-one { top: 14%; left: 12%; transform: rotate(-7deg); }.note-two { right: 5%; bottom: 19%; transform: rotate(5deg); }
  .art-caption { position: absolute; right: 12%; bottom: 9%; color: #46584c; font: .65rem ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .work-intro,.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .work-intro { padding-top: 2.6rem; border-top: 1px solid #deded5; }
  .work-intro h2,.section-heading h2,.contact h2 { margin: 0; color: var(--ink); font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.05em; line-height: 1.1; }
  .section-intro { max-width: 420px; margin: 0 0 .2rem; color: var(--muted); font-size: 1rem; line-height: 1.7; }
  .path-selectors { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .8rem; max-width: 1120px; margin-inline: auto; padding: 1.5rem 1rem 0; }
  .path-selectors a { display:flex; align-items:center; gap:.9rem; padding:1rem 1.15rem; border:1px solid var(--site-border); border-radius:14px; color:var(--ink); background:var(--site-accent-soft); text-decoration:none; }
  .path-selectors a:hover { border-color:var(--site-accent); background:var(--site-surface-raised); }
  .path-index { display:grid; place-items:center; width:2rem; height:2rem; flex:0 0 2rem; border-radius:50%; color:var(--green); background:var(--site-accent-soft); font:700 .76rem ui-monospace,monospace; }
  .path-selectors strong,.path-selectors small { display:block; }
  .path-selectors strong { font-size:.88rem; }
  .path-selectors small { margin-top:.18rem; color:var(--ink); font-size:.72rem; }
  .path-arrow { margin-left:auto; color:var(--green); font-size:1.1rem; }
  .work-group { padding-top:3rem; }
  .group-heading { margin-bottom:1rem; }
  .group-heading .eyebrow { margin-bottom:.45rem; }
  .group-heading h3 { margin:0; color:var(--ink); font-size:1.6rem; letter-spacing:-.04em; }
  .work-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.3rem; padding-top: 2rem; }
  .work-card { overflow: hidden; border: 1px solid var(--site-border); border-radius: 20px; background: var(--site-surface-raised); box-shadow: 0 12px 32px #23382f0a; }
  .work-card:hover { transform: translateY(-3px); box-shadow: 0 18px 38px #23382f13; }
  .card-topline { display: flex; justify-content: space-between; align-items: center; padding: 1.05rem 1.2rem 0; color: var(--site-muted); font: 600 .67rem ui-monospace, monospace; letter-spacing: .09em; text-transform: uppercase; }
  .work-number { color: var(--green); }.work-type { text-align: right; }
  .card-visual { position: relative; display: flex; flex-direction: column; justify-content: center; height: 225px; margin: .85rem 1rem 0; overflow: hidden; border-radius: 12px; }
  .vette-visual { padding: 1rem; background: #23332e; color: #f3f1e9; }
  .quality-flow { display:grid; grid-template-columns:1fr auto 1fr auto 1fr; align-items:center; gap:.4rem; }
  .quality-step { display:flex; flex-direction:column; gap:.45rem; min-height:72px; justify-content:center; padding:.7rem .55rem; border:1px solid #ffffff2c; border-radius:9px; background:#ffffff0b; }
  .quality-step span { color:#c4ddb8; font:600 .58rem ui-monospace,monospace; }
  .quality-step b { color:#f3f1e9; font-size:.65rem; line-height:1.35; }
  .quality-connector { color:#b4c9a7; font-size:.8rem; }
  .quality-foot { margin-top:.8rem; color:#bec9bd; font: .56rem ui-monospace,monospace; letter-spacing:.12em; text-align:center; }
  .conversation-visual { display:flex; padding:0; background:#070b14; color:#c6d1df; }
  .conversation-sidebar { display:flex; flex:0 0 31%; flex-direction:column; gap:.45rem; min-width:0; padding:.55rem .45rem; border-right:1px solid #273142; background:#0c1220; font-size:.46rem; line-height:1.35; }
  .conversation-sidebar-head { display:flex; justify-content:space-between; align-items:center; color:#eef3fa; font-size:.48rem; }
  .conversation-sidebar-head strong { letter-spacing:.09em; }
  .conversation-sidebar-head span { color:#8290a2; }
  .conversation-line-list { display:grid; gap:.22rem; }
  .conversation-line-list>div { display:flex; align-items:center; gap:.2rem; min-width:0; white-space:nowrap; }
  .line-check { display:grid; place-items:center; width:.48rem; height:.48rem; flex:none; border-radius:2px; color:#10202c; background:#a9dff2; font-size:.4rem; font-style:normal; }
  .line-dot { width:.32rem; height:.32rem; flex:none; border-radius:50%; }
  .dot-blue { background:#63b6dc; }.dot-gold { background:#e2a343; }.dot-green { background:#65c7aa; }.dot-yellow { background:#e5df62; }
  .conversation-line-list span { overflow:hidden; flex:1; text-overflow:ellipsis; }
  .conversation-line-list small,.conversation-line-list b { color:#8290a2; font-size:.42rem; font-weight:400; }
  .conversation-note { display:flex; gap:.3rem; margin-top:auto; padding:.35rem; border:1px solid #293447; border-radius:5px; color:#aab6c6; }
  .conversation-note i { width:.3rem; height:.3rem; flex:none; margin-top:.12rem; border-radius:50%; background:#90d7ee; }
  .conversation-legend { display:flex; flex-wrap:wrap; gap:.3rem; color:#aab6c6; font-size:.4rem; }
  .conversation-filters { display:grid; gap:.15rem; padding:.3rem; border:1px solid #293447; border-radius:5px; color:#b8c3d1; font-size:.4rem; }
  .conversation-filters strong { color:#eef3fa; font-weight:600; }
  .conversation-canvas { position:relative; display:flex; flex:1; min-width:0; align-items:center; overflow:hidden; background:#070b14; }
  .conversation-canvas svg { width:100%; height:100%; }
  .conversation-grid path { fill:none; stroke:#202c3c; stroke-width:1; }
  .conversation-path { fill:none; stroke-width:5; stroke-linecap:round; stroke-linejoin:round; filter:drop-shadow(0 0 3px currentColor); }
  .path-cyan { stroke:#62bddd; color:#62bddd; }.path-gold { stroke:#d9d85f; color:#d9d85f; }.path-amber { stroke:#dca242; color:#dca242; }
  .conversation-hint { position:absolute; right:.35rem; bottom:.35rem; max-width:calc(100% - .7rem); overflow:hidden; padding:.2rem .35rem; border:1px solid #293447; border-radius:4px; color:#9aa8ba; background:#0c1220cc; font-size:.4rem; white-space:nowrap; text-overflow:ellipsis; }
  .systems-visual { padding: 1.3rem 1.5rem; background: #e7e2f2; }.system-label,.pipeline-label{color:#5b5171;font:700 .62rem ui-monospace,monospace;letter-spacing:.14em}.system-row{display:flex;align-items:center;gap:.6rem;margin-top:1rem;color:#3d3949;font-size:.77rem;font-weight:650}.swatch{width:23px;height:23px;border-radius:7px;background:#446c5b}.s2{background:#cf806e}.s3{background:#a18bc8}.row-line{height:1px;flex:1;background:#bdb5cc}.system-row b{color:#645b73;font: .65rem ui-monospace,monospace}.system-foot{display:flex;justify-content:space-between;margin-top:1.2rem;color:#625878;font: .57rem ui-monospace,monospace;letter-spacing:.11em}
  .pipeline-visual{padding:1.4rem 1.6rem;background:#e7eee8}.pipeline-label{color:#52705d}.pipeline-line{display:flex;align-items:center;margin-top:2rem}.pipe-node{display:grid;place-items:center;flex:0 0 30px;height:30px;border:1px solid #91a999;border-radius:50%;color:#456a52;background:#f7faf6;font-size:.75rem}.pipe-node.active{border-color:#255b47;color:white;background:#255b47}.pipe-track{height:2px;flex:1;background:#9aac9d}.pipeline-stages{display:flex;justify-content:space-between;margin-top:.45rem;color:#566b5d;font: .58rem ui-monospace,monospace}.pipeline-metric{display:flex;align-items:baseline;gap:.65rem;margin-top:1.1rem;color:#536a59}.pipeline-metric strong{color:#255b47;font:700 1.55rem ui-monospace,monospace;letter-spacing:-.08em}.pipeline-metric small{font-size:.64rem}
