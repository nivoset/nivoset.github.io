---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
---

<BaseLayout title="Home" description="Nomad Poker - The innovative two-dimensional card game perfect for bars and casinos. Place bets on six hands, move strategically, and win!">
	<Hero 
		title="Nomad Poker"
		subtitle="The Two-Dimensional Card Game That's Taking Bars and Casinos by Storm"
		ctaText="Get Started"
		ctaLink="/contact"
	/>
	
	<!-- Game Overview -->
	<section class="py-16 bg-emerald-950">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto text-center mb-12">
				<h2 class="text-3xl md:text-4xl font-bold text-yellow-400 mb-4">How It Works</h2>
				<p class="text-lg text-amber-50">
					Nomad Poker is a unique two-dimensional card game that combines strategy, excitement, and social interaction. 
					Players place bets on one of six 5-card hands, and as cards are revealed, they can strategically move their bets 
					to adjacent hands. The player whose bet is on the hand with the highest card value at the end wins!
				</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
				<Card title="1. Place Your Bet">
					<p class="text-amber-50">
						Start by placing a bet on one of six 5-card hands laid out in front of you.
					</p>
				</Card>
				<Card title="2. Cards Reveal">
					<p class="text-amber-50">
						Watch as cards are revealed one at a time for each hand. Analyze the emerging patterns and values.
					</p>
				</Card>
				<Card title="3. Move Strategically">
					<p class="text-amber-50">
						After each reveal, decide whether to move your bet to an adjacent hand or stay put. Strategy is key!
					</p>
				</Card>
			</div>
		</div>
	</section>
	
	<!-- Key Features -->
	<section class="py-16 bg-emerald-900">
		<div class="container mx-auto px-4">
			<h2 class="text-3xl md:text-4xl font-bold text-yellow-400 text-center mb-12">Why Nomad Poker?</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
				<Card>
					<h3 class="text-xl font-semibold text-yellow-400 mb-3">🎲 Unique Gameplay</h3>
					<p class="text-amber-50">
						Unlike traditional poker, Nomad Poker's two-dimensional betting system creates a fresh, engaging experience that keeps players coming back.
					</p>
				</Card>
				<Card>
					<h3 class="text-xl font-semibold text-yellow-400 mb-3">👥 Social & Fun</h3>
					<p class="text-amber-50">
						Perfect for bars and social venues. The game encourages interaction and creates an exciting atmosphere that draws crowds.
					</p>
				</Card>
				<Card>
					<h3 class="text-xl font-semibold text-yellow-400 mb-3">📈 Easy to Learn</h3>
					<p class="text-amber-50">
						Simple rules that anyone can pick up quickly, but with enough depth to keep experienced players engaged.
					</p>
				</Card>
				<Card>
					<h3 class="text-xl font-semibold text-yellow-400 mb-3">💰 Revenue Driver</h3>
					<p class="text-amber-50">
						Increases customer engagement and time spent at your establishment, leading to more food and beverage sales.
					</p>
				</Card>
				<Card>
					<h3 class="text-xl font-semibold text-yellow-400 mb-3">🏆 Proven Creator</h3>
					<p class="text-amber-50">
						Designed by Randy Glover, the creator of the classic Jumpman game, bringing decades of game design expertise.
					</p>
				</Card>
				<Card>
					<h3 class="text-xl font-semibold text-yellow-400 mb-3">🎯 Casino Ready</h3>
					<p class="text-amber-50">
						Designed with casino environments in mind, offering a new gaming option that appeals to both casual and serious players.
					</p>
				</Card>
			</div>
		</div>
	</section>
	
	<!-- Quick Rules -->
	<section class="py-16 bg-emerald-950">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-bold text-yellow-400 text-center mb-12">Quick Rules</h2>
				<Card class="mb-6">
					<ol class="space-y-4 text-amber-50 list-decimal list-inside">
						<li class="pl-2">
							<strong class="text-yellow-400">Place a bet</strong> on one of six 5-card hands displayed on the table.
						</li>
						<li class="pl-2">
							<strong class="text-yellow-400">Cards are revealed</strong> one at a time for each hand, creating suspense and strategic opportunities.
						</li>
						<li class="pl-2">
							<strong class="text-yellow-400">Move your bet</strong> (or keep it where it is) to an adjacent hand after each card reveal. This is where strategy comes into play!
						</li>
						<li class="pl-2">
							<strong class="text-yellow-400">Win condition:</strong> At the end of the game, if your bet is on the hand with the highest card value, you win!
						</li>
					</ol>
				</Card>
				<p class="text-center text-amber-100/70 italic">
					The game combines elements of chance and strategy, making every round exciting and unpredictable.
				</p>
			</div>
		</div>
	</section>
	
	<!-- Call to Action -->
	<section class="py-16 bg-gradient-to-br from-yellow-500 to-yellow-600">
		<div class="container mx-auto px-4 text-center">
			<h2 class="text-3xl md:text-4xl font-bold text-emerald-900 mb-4">Ready to Bring Nomad Poker to Your Venue?</h2>
			<p class="text-xl text-emerald-950 mb-8 max-w-2xl mx-auto">
				Contact us today to learn about licensing opportunities, partnership options, and how Nomad Poker can enhance your establishment.
			</p>
			<a 
				href="/contact"
				class="inline-block bg-emerald-900 hover:bg-emerald-800 text-yellow-400 font-bold px-8 py-3 rounded-lg transition-colors shadow-lg"
			>
				Get in Touch
			</a>
		</div>
	</section>
</BaseLayout>