---
const currentYear = new Date().getFullYear();
---

<footer class="bg-federal-gray border-t border-ominous-teal/30 mt-auto shadow-lg" role="contentinfo">
	<div class="container mx-auto px-4 py-8">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- About -->
			<div>
				<h3 class="text-lg font-heading font-semibold text-worker-gold mb-4">About</h3>
				<p class="text-warmlight-sand/80 text-sm">
					Developer tools, AI experiments, union organizing, training materials, and creative projects.
				</p>
			</div>
			
			<!-- Contact -->
			<div>
				<h3 class="text-lg font-heading font-semibold text-worker-gold mb-4">Contact</h3>
				<ul class="space-y-2 text-warmlight-sand/80 text-sm">
					<li>
						<a href="/contact" class="hover:text-worker-gold transition-colors">
							Get in touch
						</a>
					</li>
					<li>
						<a href="https://github.com/nivoset" target="_blank" rel="noopener noreferrer" class="hover:text-worker-gold transition-colors">
							GitHub
						</a>
					</li>
					<li>
						<a href="https://reddit.com/user/nivoset" target="_blank" rel="noopener noreferrer" class="hover:text-worker-gold transition-colors">
							Reddit
						</a>
					</li>
				</ul>
			</div>
			
			<!-- Accessibility -->
			<div>
				<h3 class="text-lg font-heading font-semibold text-worker-gold mb-4">Accessibility</h3>
				<ul class="space-y-2 text-warmlight-sand/80 text-sm">
					<li>
						<a href="#main-content" class="hover:text-worker-gold transition-colors">
							Skip to main content
						</a>
					</li>
					<li class="text-warmlight-sand/60">
						WCAG 2.1 AA compliant
					</li>
				</ul>
			</div>
		</div>
		
		<div class="mt-8 pt-8 border-t border-ominous-teal/20 text-center text-warmlight-sand/60 text-sm">
			<p>&copy; {currentYear} nivoset. All rights reserved.</p>
		</div>
	</div>
	
	<!-- Bear-Bear hidden element (random placement) -->
	<div id="bear-bear-container" class="relative">
		<!-- Bear-Bear will be injected here by script -->
	</div>
</footer>

<script>
	// Randomly place Bear-Bear in footer
	const bearBearContainer = document.getElementById('bear-bear-container');
	if (bearBearContainer && Math.random() > 0.7) {
		// Only show Bear-Bear 30% of the time
		bearBearContainer.innerHTML = `
			<button 
				id="bear-bear"
				class="absolute bottom-4 right-4 w-8 h-8 opacity-50 hover:opacity-100 transition-opacity cursor-pointer focus:opacity-100 focus:outline-none focus:ring-2 focus:ring-bear-bear-brown rounded"
				aria-label="Bear-Bear"
				title="Click for Bear-Bear lore"
			>
				<svg class="w-full h-full text-bear-bear-brown" viewBox="0 0 24 24" fill="currentColor">
					<circle cx="12" cy="12" r="10"/>
					<circle cx="9" cy="9" r="1.5" fill="white"/>
					<circle cx="15" cy="9" r="1.5" fill="white"/>
					<path d="M9 14 Q12 16 15 14" stroke="white" stroke-width="1.5" fill="none"/>
				</svg>
			</button>
		`;
		
		const bearBear = document.getElementById('bear-bear');
		if (bearBear) {
			bearBear.addEventListener('mouseenter', () => {
				bearBear.classList.add('animate-wiggle');
			});
			bearBear.addEventListener('mouseleave', () => {
				bearBear.classList.remove('animate-wiggle');
			});
			bearBear.addEventListener('click', () => {
				window.dispatchEvent(new CustomEvent('bear-bear-click'));
			});
		}
	}
</script>
