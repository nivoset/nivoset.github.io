---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { SITE } from "@config";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class={`${noMarginTop ? "" : "mt-auto"} border-t border-gray-200/30 dark:border-slate-800/30`}>
  <div class="footer-wrapper">
    <div class="footer-content">
      <Socials centered />
      <div class="copyright-wrapper">
        <span class="text-sm text-gray-600 dark:text-gray-400">
          Copyright &#169; {currentYear} {SITE.author}
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  @reference "tailwindcss";
  footer {
    @apply w-full bg-white/30 dark:bg-slate-900/30 backdrop-blur-sm;
  }
  
  .footer-wrapper {
    @apply py-8 sm:py-10;
  }
  
  .footer-content {
    @apply flex flex-col items-center gap-6;
  }
  
  .link-button {
    @apply p-2 hover:scale-110 transition-transform;
  }
  
  .link-button svg {
    @apply scale-110;
  }
  
  .copyright-wrapper {
    @apply text-center;
  }
</style>
