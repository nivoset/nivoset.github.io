---
interface Props {
  title: string;
  description: string;
  category: string;
  href?: string;
}

const { title, description, category, href } = Astro.props;
---

<article class="play-card">
  <p class="category">{category}</p>
  <h2>{title}</h2>
  <p>{description}</p>
  {href && (
    <a class="play-link" href={href} target="_blank" rel="noopener noreferrer">
      Play {title} <span aria-hidden="true">↗</span>
    </a>
  )}
</article>

<style>
  .play-card {
    border: 1px solid var(--site-border);
    border-radius: 1rem;
    padding: 1.25rem;
    background: var(--site-surface);
  }
  .play-card h2 { margin: 0 0 0.5rem; font-size: 1.2rem; font-weight: 700; }
  .play-card > p:not(.category) { margin: 0; line-height: 1.6; color: var(--site-muted); }
  .play-link {
    display: inline-flex;
    gap: 0.35rem;
    margin-top: 1rem;
    color: var(--site-accent);
    font-weight: 650;
  }
  .play-link:hover { color: var(--site-accent-hover); text-decoration: underline; }
  .play-card .category { margin: 0 0 0.5rem; color: var(--site-accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
</style>
