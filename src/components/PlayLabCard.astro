---
interface Props {
  title: string;
  description: string;
  category: string;
}

const { title, description, category } = Astro.props;
---

<article class="play-card">
  <p class="category">{category}</p>
  <h2>{title}</h2>
  <p>{description}</p>
</article>

<style>
  .play-card {
    border: 1px solid rgb(148 163 184 / 0.35);
    border-radius: 1rem;
    padding: 1.25rem;
    background: rgb(255 255 255 / 0.65);
  }
  :global(html[data-theme="dark"]) .play-card { background: rgb(15 23 42 / 0.65); }
  .play-card h2 { margin: 0 0 0.5rem; font-size: 1.2rem; font-weight: 700; }
  .play-card p:last-child { margin: 0; line-height: 1.6; color: rgb(71 85 105); }
  :global(html[data-theme="dark"]) .play-card p:last-child { color: rgb(203 213 225); }
  .play-card .category { margin: 0 0 0.5rem; color: rgb(37 99 235); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
</style>
