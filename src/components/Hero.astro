---
import MindMap from './MindMap.astro';
---

<section class="container mx-auto px-4 py-16 md:py-24">
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
		<!-- Left side: Name, roles, bio, CTAs -->
		<div class="space-y-6">
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-warmlight-sand">
				nivoset
			</h1>
			
			<div class="space-y-2">
				<p class="text-xl md:text-2xl text-fog-blue font-medium">
					Developer • Tool Builder • Union Organizer
				</p>
				<p class="text-lg text-warmlight-sand/80">
					Building tools, experimenting with AI, organizing for worker power, and creating training materials.
				</p>
			</div>
			
			<div class="flex flex-wrap gap-4 pt-4">
				<a 
					href="/systems" 
					class="btn btn-primary"
					aria-label="View my work"
				>
					View My Work
				</a>
				<a 
					href="/organizing" 
					class="btn btn-secondary"
					aria-label="What I'm organizing"
				>
					What I'm Organizing
				</a>
			</div>
		</div>
		
		<!-- Right side: Mind Map -->
		<div class="flex justify-center items-center">
			<MindMap />
		</div>
	</div>
</section>
