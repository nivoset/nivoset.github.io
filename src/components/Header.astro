---
const currentPath = Astro.url.pathname;
const navItems = [
	{ href: '/', label: 'About' },
	{ href: '/systems', label: 'Systems & Tools' },
	{ href: '/ai', label: 'AI & Automation' },
	{ href: '/training', label: 'Training & Writing' },
	{ href: '/organizing', label: 'Organizing & Worker Power' },
	{ href: '/play', label: 'Play Lab' },
	{ href: '/contact', label: 'Contact' },
];
---

<header class="bg-federal-gray border-b border-ominous-teal/30 sticky top-0 z-50 shadow-lg" role="banner" style="background: var(--color-federal-gray);">
	<nav class="container mx-auto px-4 py-4" aria-label="Main navigation">
		<div class="flex items-center justify-between">
			<a href="/" class="flex items-center space-x-2 text-xl font-heading font-bold text-warmlight-sand hover:text-worker-gold transition-colors">
				<span>nivoset</span>
			</a>
			
			<!-- Mobile menu button -->
			<button 
				id="mobile-menu-button"
				class="md:hidden text-warmlight-sand hover:text-worker-gold transition-colors focus:outline-none focus:ring-2 focus:ring-worker-gold rounded p-2"
				aria-label="Toggle menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
				<svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
			
			<!-- Desktop navigation -->
			<ul class="hidden md:flex items-center space-x-6" role="list">
				{navItems.map((item) => (
					<li role="listitem">
						<a 
							href={item.href}
							class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
								currentPath === item.href
									? 'bg-union-red text-warmlight-sand font-bold shadow-lg'
									: 'text-warmlight-sand hover:text-worker-gold hover:bg-federal-gray/50'
							}`}
							aria-current={currentPath === item.href ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</div>
		
		<!-- Mobile navigation -->
		<ul id="mobile-menu" class="hidden md:hidden mt-4 space-y-2" role="list" aria-label="Mobile navigation">
			{navItems.map((item) => (
				<li role="listitem">
					<a 
						href={item.href}
						class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
							currentPath === item.href
								? 'bg-union-red text-warmlight-sand font-bold shadow-lg'
								: 'text-warmlight-sand hover:text-worker-gold hover:bg-federal-gray/50'
						}`}
						aria-current={currentPath === item.href ? 'page' : undefined}
					>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
	
	<!-- Hidden terminal icon (easter egg trigger) -->
	<button 
		id="terminal-trigger"
		class="absolute bottom-2 right-2 w-6 h-6 opacity-0 hover:opacity-100 transition-opacity focus:opacity-100 focus:outline-none focus:ring-2 focus:ring-worker-gold rounded"
		aria-label="Open terminal mode"
		title="Terminal Mode"
	>
		<svg class="w-full h-full text-fog-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
		</svg>
	</button>
</header>

<script>
	const menuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');
	const menuIcon = document.getElementById('menu-icon');
	const closeIcon = document.getElementById('close-icon');
	const terminalTrigger = document.getElementById('terminal-trigger');
	
	if (menuButton && mobileMenu && menuIcon && closeIcon) {
		menuButton.addEventListener('click', () => {
			const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
			const newState = !isExpanded;
			menuButton.setAttribute('aria-expanded', String(newState));
			mobileMenu.classList.toggle('hidden');
			menuIcon.classList.toggle('hidden');
			closeIcon.classList.toggle('hidden');
		});
	}
	
	// Terminal trigger handler (will be connected to Terminal component)
	if (terminalTrigger) {
		terminalTrigger.addEventListener('click', () => {
			// Dispatch custom event for terminal overlay
			window.dispatchEvent(new CustomEvent('open-terminal'));
		});
	}
</script>
