---
const items = [
  "A tiny procedural world waiting to be explored.",
  "A pixel-art sprite looking for its next animation.",
  "A cooperative game mechanic built around shared goals.",
  "A small interface experiment with one delightful interaction.",
  "A new idea: make the rules easy to learn and hard to master.",
];
---

<div class="randomizer">
  <div>
    <h2>Need a spark?</h2>
    <p id="randomized-content" aria-live="polite">Pick a random creative prompt.</p>
  </div>
  <button id="randomize-button" type="button">Surprise me</button>
</div>

<script define:vars={{ items }}>
  const button = document.getElementById("randomize-button");
  const content = document.getElementById("randomized-content");

  button?.addEventListener("click", () => {
    if (!content) return;
    const current = content.textContent;
    const choices = items.filter((item) => item !== current);
    content.textContent = choices[Math.floor(Math.random() * choices.length)];
  });
</script>

<style>
  .randomizer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border: 1px solid var(--site-border); border-radius: 1rem; padding: 1.25rem; background: var(--site-accent-soft); }
  .randomizer h2 { margin: 0 0 0.35rem; font-size: 1.15rem; font-weight: 700; }
  .randomizer p { margin: 0; color: var(--site-muted); }
  .randomizer button { flex: none; border: 0; border-radius: 0.65rem; padding: 0.7rem 1rem; background: var(--site-accent); color: var(--site-accent-foreground); font-weight: 650; cursor: pointer; }
  .randomizer button:hover { background: var(--site-accent-hover); }
  .randomizer button:focus-visible { outline: 3px solid var(--site-accent); outline-offset: 3px; }
  @media (max-width: 36rem) { .randomizer { align-items: stretch; flex-direction: column; } }
</style>
