---
---

<form 
	class="card space-y-6"
	method="POST"
	action="#"
	aria-label="Contact form"
>
	<div>
		<label for="name" class="block text-sm font-medium text-warmlight-sand mb-2">
			Name
		</label>
		<input
			type="text"
			id="name"
			name="name"
			required
			class="w-full px-4 py-2 bg-storm-slate border border-ominous-teal rounded text-warmlight-sand focus:outline-none focus:ring-2 focus:ring-worker-gold"
			aria-required="true"
		/>
	</div>
	
	<div>
		<label for="email" class="block text-sm font-medium text-warmlight-sand mb-2">
			Email
		</label>
		<input
			type="email"
			id="email"
			name="email"
			required
			class="w-full px-4 py-2 bg-storm-slate border border-ominous-teal rounded text-warmlight-sand focus:outline-none focus:ring-2 focus:ring-worker-gold"
			aria-required="true"
		/>
	</div>
	
	<div>
		<label for="message" class="block text-sm font-medium text-warmlight-sand mb-2">
			Message
		</label>
		<textarea
			id="message"
			name="message"
			rows="6"
			required
			class="w-full px-4 py-2 bg-storm-slate border border-ominous-teal rounded text-warmlight-sand focus:outline-none focus:ring-2 focus:ring-worker-gold resize-y"
			aria-required="true"
		></textarea>
	</div>
	
	<button
		type="submit"
		class="btn btn-primary w-full"
		aria-label="Submit contact form"
	>
		Send Message
	</button>
</form>

<script>
	const form = document.currentScript?.previousElementSibling as HTMLFormElement;
	
	if (form) {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			
			// In a real implementation, this would submit to a backend or service
			// For now, we'll just show a success message
			const formData = new FormData(form);
			console.log('Form data:', Object.fromEntries(formData));
			
			// Show success message
			const successMsg = document.createElement('div');
			successMsg.className = 'mt-4 p-4 bg-spreadsheet-green text-storm-slate rounded';
			successMsg.textContent = 'Thank you for your message! I\'ll get back to you soon.';
			successMsg.setAttribute('role', 'alert');
			
			form.appendChild(successMsg);
			
			// Reset form
			form.reset();
			
			// Remove success message after 5 seconds
			setTimeout(() => {
				successMsg.remove();
			}, 5000);
		});
	}
</script>

