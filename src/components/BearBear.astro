<details class="bear-bear">
  <summary aria-label="Open Bear-Bear lore" title="A tiny Play Lab visitor">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="10" fill="currentColor" />
      <circle cx="9" cy="9" r="1.5" fill="white" />
      <circle cx="15" cy="9" r="1.5" fill="white" />
      <path d="M9 14 Q12 16 15 14" stroke="white" stroke-width="1.5" fill="none" />
    </svg>
  </summary>
  <div class="lore">
    <strong>Bear-Bear</strong>
    <p>A tiny pixel bear bringing good luck to developers, artists, and organizers.</p>
  </div>
</details>

<style>
  .bear-bear { position: fixed; right: 1rem; bottom: 1rem; z-index: 20; color: rgb(146 96 50); }
  .bear-bear summary { display: block; width: 3rem; height: 3rem; cursor: pointer; opacity: 0.72; list-style: none; }
  .bear-bear summary::-webkit-details-marker { display: none; }
  .bear-bear summary:hover, .bear-bear summary:focus-visible { opacity: 1; }
  .bear-bear summary:focus-visible { outline: 3px solid rgb(96 165 250); outline-offset: 3px; border-radius: 50%; }
  .bear-bear svg { width: 100%; height: 100%; }
  .lore { position: absolute; right: 0; bottom: 3.5rem; width: min(18rem, calc(100vw - 2rem)); border: 1px solid rgb(148 163 184 / 0.4); border-radius: 0.75rem; padding: 1rem; background: white; color: rgb(15 23 42); box-shadow: 0 12px 32px rgb(15 23 42 / 0.2); }
  :global(html[data-theme="dark"]) .lore { background: rgb(15 23 42); color: rgb(241 245 249); }
  .lore p { margin: 0.35rem 0 0; line-height: 1.5; }
</style>
