---
---

<div 
	id="terminal-overlay"
	class="fixed inset-0 bg-graphite-black/95 flex items-center justify-center z-[100] p-4 hidden"
	role="dialog"
	aria-modal="true"
	aria-labelledby="terminal-title"
	aria-hidden="true"
>
	<div class="bg-storm-slate rounded-lg max-w-3xl w-full h-[600px] border-2 border-ominous-teal shadow-2xl flex flex-col">
		<div class="flex items-center justify-between p-4 border-b border-ominous-teal">
			<h2 id="terminal-title" class="text-lg font-mono font-bold text-ominous-teal">
				Terminal Mode
			</h2>
			<button
				id="close-terminal"
				class="text-warmlight-sand hover:text-union-red transition-colors focus:outline-none focus:ring-2 focus:ring-worker-gold rounded p-2"
				aria-label="Close terminal"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
		
		<div 
			id="terminal-output"
			class="flex-1 p-4 overflow-y-auto font-mono text-sm text-warmlight-sand space-y-2"
			role="log"
			aria-live="polite"
		>
			<div>Terminal Mode v1.0</div>
			<div>Type 'help' for available commands.</div>
			<div class="text-ominous-teal">---</div>
		</div>
		
		<div class="p-4 border-t border-ominous-teal flex items-center gap-2">
			<span class="text-ominous-teal font-mono">$</span>
			<input
				type="text"
				id="terminal-input"
				class="flex-1 bg-transparent border-none outline-none text-warmlight-sand font-mono text-sm"
				placeholder="Enter command..."
				autocomplete="off"
				aria-label="Terminal input"
			/>
		</div>
	</div>
</div>

<script>
	import { executeCommand } from '../lib/terminalCommands.js';
	
	const overlay = document.getElementById('terminal-overlay');
	const closeButton = document.getElementById('close-terminal');
	const input = document.getElementById('terminal-input');
	const output = document.getElementById('terminal-output');
	
	if (overlay && closeButton && input && output) {
		const showTerminal = () => {
			overlay.classList.remove('hidden');
			overlay.setAttribute('aria-hidden', 'false');
			input.focus();
		};
		
		const hideTerminal = () => {
			overlay.classList.add('hidden');
			overlay.setAttribute('aria-hidden', 'true');
			input.value = '';
		};
		
		const addOutput = (text, className = '') => {
			const line = document.createElement('div');
			line.className = className;
			line.textContent = text;
			output.appendChild(line);
			if (output.scrollTop !== undefined) {
				output.scrollTop = output.scrollHeight;
			}
		};
		
		const clearOutput = () => {
			output.innerHTML = `
				<div>Terminal Mode v1.0</div>
				<div>Type 'help' for available commands.</div>
				<div class="text-ominous-teal">---</div>
			`;
		};
		
		input.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				const command = input.value.trim();
				if (command) {
					// Show command
					addOutput(`$ ${command}`, 'text-ominous-teal');
					
					// Execute command
					const result = executeCommand(command);
					
					if (result === 'CLEAR') {
						clearOutput();
					} else {
						// Show result (preserve line breaks)
						result.split('\n').forEach(line => {
							addOutput(line);
						});
					}
					
					input.value = '';
				}
			}
		});
		
		window.addEventListener('open-terminal', showTerminal);
		
		closeButton.addEventListener('click', hideTerminal);
		
		overlay.addEventListener('click', (e) => {
			if (e.target === overlay) {
				hideTerminal();
			}
		});
		
		overlay.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				hideTerminal();
			}
		});
	}
</script>

