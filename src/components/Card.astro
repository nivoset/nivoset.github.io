---
interface Props {
	title?: string;
	class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`bg-emerald-800/80 backdrop-blur-sm rounded-lg p-6 border-2 border-yellow-500/30 shadow-lg hover:shadow-xl hover:border-yellow-500/50 transition-all ${className}`}>
	{title && (
		<h3 class="text-xl font-semibold text-yellow-400 mb-4 drop-shadow-sm">{title}</h3>
	)}
	<slot />
</div>
