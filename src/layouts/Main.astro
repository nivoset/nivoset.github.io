---
import Breadcrumbs from "@components/Breadcrumbs.astro";

export interface Props {
  pageTitle: string;
  pageDesc?: string;
}

const { pageTitle, pageDesc } = Astro.props;
---

<Breadcrumbs />
<main id="main-content" tabindex="-1">
  <div class="page-header">
    <h1 class="page-title">{pageTitle}</h1>
    {pageDesc && <p class="page-description">{pageDesc}</p>}
  </div>
  <slot />
</main>

<style>
  @reference "../styles/base.css";
  
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-16 pt-8 sm:px-6 sm:pt-12 lg:px-8;
  }
  
  .page-header {
    @apply mb-12 border-b border-border/50 pb-8;
  }
  
  .page-title {
    @apply mb-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl;
  }
  
  .page-description {
    @apply text-lg leading-relaxed text-muted;
  }
</style>
